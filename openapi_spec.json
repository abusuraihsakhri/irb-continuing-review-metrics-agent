{
  "openapi": "3.1.0",
  "info": {
    "title": "IRB Continuing Review Metrics Rule Demo API",
    "version": "2.0.1",
    "description": "Rule demonstration only; thresholds are not validated regulatory cutoffs."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Get service health",
        "responses": {
          "200": {
            "description": "Service is running"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Get JSON process counters",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/metrics/prometheus": {
      "get": {
        "summary": "Get Prometheus-formatted counters",
        "responses": {
          "200": {
            "description": "Text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate example rules",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  },
                  "attributes": {
                    "type": "object"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluation dossier"
          },
          "422": {
            "description": "Invalid input or a prohibited identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock chat",
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "422": {
            "description": "Input rejected"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read and verify in-memory HMAC audit metadata",
        "responses": {
          "200": {
            "description": "Audit entries and verification result"
          }
        }
      }
    }
  }
}
